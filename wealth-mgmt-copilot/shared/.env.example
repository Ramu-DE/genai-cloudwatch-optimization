# Dhan Brokerage Credentials (Read-Only Access)
# Copy this file to .env and fill in your values
#
# HOW TO GET YOUR DHAN API CREDENTIALS:
# 1. Go to https://dhanhq.co/
# 2. Log in with your Dhan trading account
# 3. Navigate to "API Access" section
# 4. Generate your access token
# 5. Copy Client ID and Access Token below
#
# NOTE: The system only uses READ-ONLY access — it never places orders.
# Your access token may need periodic renewal from the Dhan developer portal.

DHAN_CLIENT_ID=your_dhan_client_id_here
DHAN_ACCESS_TOKEN=your_dhan_access_token_here

# (Legacy) Groww credentials — optional, if you also have a Groww account
# GROWW_AUTH_TOKEN=Bearer eyJhbGciOi...your_token_here
# GROWW_CLIENT_ID=your_groww_client_id
