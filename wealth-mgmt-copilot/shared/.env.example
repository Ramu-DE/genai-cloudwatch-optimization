# Groww Credentials (Read-Only Access)
# Copy this file to .env and fill in your values
#
# HOW TO GET YOUR GROWW TOKEN:
# 1. Open https://groww.in in your browser
# 2. Log into your Groww account
# 3. Open Developer Tools (F12 or Cmd+Option+I)
# 4. Go to Network tab
# 5. Click any page in Groww (e.g., Stocks > Holdings)
# 6. Find any API request to groww.in/v1/api/*
# 7. Copy the "Authorization" header value (starts with "Bearer ey...")
# 8. Paste it below
#
# NOTE: This token expires periodically. You'll need to refresh it.
# The system only uses READ-ONLY access — it never places orders.

GROWW_AUTH_TOKEN=Bearer eyJhbGciOi...your_token_here
GROWW_CLIENT_ID=client_ramu_de
